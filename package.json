{
  "name": "pixelvault-cli",
  "version": "0.1.0",
  "description": "CLI for PixelVault — agent-first image hosting",
  "type": "module",
  "bin": {
    "pixelvault": "./bin/pixelvault.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pixelvault",
    "image-hosting",
    "cli",
    "agent",
    "upload"
  ],
  "author": "PixelVault",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
